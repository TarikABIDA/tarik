# Apollo.io API key (Settings → Integrations → API)
APOLLO_API_KEY=your_apollo_api_key_here

# Google Sheets spreadsheet ID (from the sheet URL)
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_ID=your_google_spreadsheet_id_here

# Path to Google service-account JSON credentials
GOOGLE_CREDENTIALS_PATH=./credentials/google_service_account.json

# Optional: override default filter thresholds
MIN_MONTHLY_TRAFFIC=10000
MIN_ESTIMATED_REVENUE=100000

# Optional: request delay (seconds) between Apollo calls to avoid rate limits
APOLLO_REQUEST_DELAY=0.5
